<Window x:Class="BUMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BUMirror.ViewModels"
        xmlns:cv="clr-namespace:BUMirror.Converters"
        Title="BUMirror — バックアップ差分確認ツール"
        MinWidth="1100" MinHeight="680"
        Width="1300" Height="820"
        Background="{StaticResource BrBg}"
        FontFamily="Yu Gothic UI, Segoe UI"
        AllowDrop="True"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Window.Resources>
        <cv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <cv:SideToBrushConverter              x:Key="SideBrush"/>
        <cv:SideToBadgeConverter              x:Key="SideBadge"/>
        <cv:SideToBadgeBrushConverter         x:Key="SideBadgeBrush"/>
        <cv:CountToVisibilityConverter        x:Key="CountVis"/>
        <cv:FileToThumbnailConverter         x:Key="FileThumb"/>
        <cv:FileToPreviewImageConverter      x:Key="FilePreview"/>
        <cv:NullToVisibilityConverter        x:Key="NullVis"/>

        <Style TargetType="TextBlock" x:Key="ListTextStyle">
            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrGold}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="ListMutedTextStyle">
            <Setter Property="Foreground" Value="{StaticResource BrMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrGold}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="ListBadgeTextStyle">
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrGold}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP: フォルダ選択・設定 -->
            <RowDefinition Height="Auto"/>
            <!-- MIDDLE: ツールバー + リスト -->
            <RowDefinition Height="*"/>
            <!-- BOTTOM: ステータスバー -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             TOP PANEL
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrPanel}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,16,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- フォルダA -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📁  フォルダ A"
                               Foreground="{StaticResource BrText}"
                               FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding FolderA, UpdateSourceTrigger=PropertyChanged}"
                             AllowDrop="True"
                             PreviewDragOver="FolderTextBox_PreviewDragOver"
                             PreviewDrop="FolderTextBox_PreviewDrop"
                             Tag="A"
                             VerticalContentAlignment="Center"
                             Height="32"/>
                    <Button Grid.Column="3"
                            Content="選択..."
                            Style="{StaticResource AccentButton}"
                            Command="{Binding BrowseFolderACommand}"
                            Height="32"/>
                </Grid>

                <!-- フォルダB -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📁  フォルダ B"
                               Foreground="{StaticResource BrText}"
                               FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding FolderB, UpdateSourceTrigger=PropertyChanged}"
                             AllowDrop="True"
                             PreviewDragOver="FolderTextBox_PreviewDragOver"
                             PreviewDrop="FolderTextBox_PreviewDrop"
                             Tag="B"
                             VerticalContentAlignment="Center"
                             Height="32"/>
                    <Button Grid.Column="3"
                            Content="選択..."
                            Style="{StaticResource AccentButton}"
                            Command="{Binding BrowseFolderBCommand}"
                            Height="32"/>
                </Grid>

                <!-- オプション行 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="110,0,0,0">
                    <CheckBox Content="サブフォルダを含める"
                              IsChecked="{Binding Recursive}"
                              Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Background="{StaticResource BrBorder}"
                               Margin="0,0,20,0"/>

                    <!-- 比較実行ボタン -->
                    <Button Content="🔍  比較実行"
                            Background="#EC4899"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding CompareCommand}"
                            FontSize="14" FontWeight="Bold"
                            Padding="22,8"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F472B6"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#44EC4899"/>
                                        <Setter Property="Foreground" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 停止ボタン -->
                    <Button Content="■  停止"
                            Style="{StaticResource SubButton}"
                            Command="{Binding CancelCommand}"
                            FontSize="14"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             MIDDLE: ツールバー + リスト
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- ツールバー -->
                <RowDefinition Height="6"/>      <!-- プログレス -->
                <RowDefinition Height="*"/>      <!-- リスト + プレビュー -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>   <!-- リスト -->
                <ColumnDefinition Width="6"/>                  <!-- スプリッター -->
                <ColumnDefinition Width="340" MinWidth="200"/> <!-- プレビュー -->
            </Grid.ColumnDefinitions>

            <!-- ツールバー -->
            <Border Grid.Row="0" Grid.ColumnSpan="3"
                    Background="{StaticResource BrPanel}"
                    BorderBrush="{StaticResource BrBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: アクションボタン群 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="📋  選択したファイルをコピー"
                                Background="#B43C3C"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding CopySelectedCommand}"
                                FontSize="13" Padding="16,7"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D45050"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#44B43C3C"/>
                                            <Setter Property="Foreground" Value="#66FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Aを選択"
                                Style="{StaticResource SubButton}"
                                Command="{Binding SelectACommand}"
                                Padding="12,7" Margin="0,0,6,0"/>
                        <Button Content="Bを選択"
                                Style="{StaticResource SubButton}"
                                Command="{Binding SelectBCommand}"
                                Padding="12,7" Margin="0,0,6,0"/>
                        <Button Content="❌  全て解除"
                                Style="{StaticResource SubButton}"
                                Command="{Binding DeselectAllCommand}"
                                Padding="12,7" Margin="0,0,20,0"/>

                        <!-- 選択件数バッジ -->
                        <Border Background="#336366F1" CornerRadius="12" Padding="10,3"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedCount, Mode=OneWay, Converter={StaticResource CountVis}}">
                            <TextBlock Foreground="#AABBFF" FontSize="12">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text=" 件選択中"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 右: フィルタ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- サマリーバッジ A -->
                        <Border Background="#44B45050" CornerRadius="4" Padding="10,4"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryA}"
                                       Foreground="#FFBBBB" FontSize="12"/>
                        </Border>
                        <!-- サマリーバッジ B -->
                        <Border Background="#445078B4" CornerRadius="4" Padding="10,4"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryB}"
                                       Foreground="#AACCFF" FontSize="12"/>
                        </Border>

                        <!-- サイドフィルタ -->
                        <TextBlock Text="表示:" Foreground="{StaticResource BrMuted}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="110"
                                  x:Name="FilterSideCombo"
                                  Text="{Binding FilterSide, Mode=TwoWay}"
                                  SelectionChanged="FilterSideCombo_SelectionChanged"
                                  Margin="0,0,12,0">
                            <ComboBoxItem>すべて</ComboBoxItem>
                            <ComboBoxItem>A のみ</ComboBoxItem>
                            <ComboBoxItem>B のみ</ComboBoxItem>
                        </ComboBox>

                        <!-- キーワードフィルタ -->
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Width="220" Height="30"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Yu Gothic UI, Segoe UI"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="カンマ区切りでOR検索 (例: jpg, txt)">
                            <TextBox.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍  検索 (カンマ区切りOR)..."
                                                                       Foreground="#55DCDCF0"
                                                                       FontSize="11.5"
                                                                       Margin="10,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- プログレスバー -->
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                         Value="{Binding Progress}"
                         Maximum="100"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                         Height="6"/>

            <!-- リストビュー (仮想化を有効にして大量件数でも軽量に表示) -->
            <ListView Grid.Row="2" Grid.Column="0"
                      x:Name="MainListView"
                      ItemsSource="{Binding Entries}"
                      SelectionMode="Extended"
                      SelectionChanged="MainListView_SelectionChanged"
                      PreviewMouseLeftButtonDown="MainListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="MainListView_PreviewMouseMove"
                      KeyDown="MainListView_KeyDown"
                      Margin="0"
                      BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsDeferredScrollingEnabled="True">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="場所を開く" Click="OnContextMenuOpenLocationClick"/>
                        <MenuItem Header="名前の変更" Click="OnContextMenuRenameClick"/>
                        <MenuItem Header="削除" Click="OnContextMenuDeleteClick"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView>
                        <!-- Thumbnail -->
                        <GridViewColumn Width="46">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FullPath, Converter={StaticResource FileThumb}}"
                                           Width="24" Height="24"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 存在するフォルダ -->
                        <GridViewColumn Header="フォルダ" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ExistsIn, Converter={StaticResource SideBadgeBrush}}"
                                            CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ExistsIn, Converter={StaticResource SideBadge}}"
                                                   Style="{StaticResource ListBadgeTextStyle}"
                                                   FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- ファイル名 (相対パス) -->
                        <GridViewColumn Header="ファイル名" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="tbName"
                                                   Text="{Binding FileName}"
                                                   Style="{StaticResource ListTextStyle}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="12"
                                                   Padding="4,3"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBox x:Name="txtEditName"
                                                 Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas, Courier New"
                                                 FontSize="12"
                                                 Visibility="Collapsed"
                                                 IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                                 KeyDown="RenameTextBox_KeyDown"
                                                 LostFocus="RenameTextBox_LostFocus"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="tbName" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="txtEditName" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- サイズ -->
                        <GridViewColumn Header="サイズ" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeStr}"
                                               Style="{StaticResource ListMutedTextStyle}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               Padding="4,3,8,3"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 更新日時 -->
                        <GridViewColumn Header="更新日時" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastWriteStr}"
                                               Style="{StaticResource ListMutedTextStyle}"
                                               FontSize="12" Padding="4,3"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <!-- 行の背景色をバインドで設定 -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="Background" Value="{Binding ExistsIn, Converter={StaticResource SideBrush}}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemMouseDoubleClick"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListViewItemPreviewMouseRightButtonDown"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- 空状態メッセージ (ListView と重ねて表示) -->
            <StackPanel Grid.Row="2" Grid.Column="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="📂" FontSize="48"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="比較を実行すると差分ファイルが表示されます"
                           Foreground="{StaticResource BrMuted}"
                           FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- スプリッター -->
            <GridSplitter Grid.Row="2" Grid.Column="1"
                          Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BrBorder}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- プレビュー枠 (選択中のアイテムを表示) -->
            <Border Grid.Row="2" Grid.Column="2"
                    Background="{StaticResource BrPanel}"
                    BorderBrush="{StaticResource BrBorder}"
                    BorderThickness="1,0,0,0"
                    Padding="14"
                    DataContext="{Binding SelectedItem, ElementName=MainListView}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="👁  プレビュー"
                               Foreground="{StaticResource BrText}"
                               FontWeight="Bold" FontSize="13"/>

                    <!-- サムネイル / 動画サムネイル -->
                    <Border Grid.Row="1" Margin="0,10,0,10"
                            Background="{StaticResource BrCard}"
                            BorderBrush="{StaticResource BrBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding FullPath, Converter={StaticResource FilePreview}, ConverterParameter=520}"
                                   Stretch="Uniform" Margin="6"/>
                            <TextBlock Text="ファイルを選択してください"
                                       Foreground="{StaticResource BrMuted}"
                                       FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedItem, ElementName=MainListView, Converter={StaticResource NullVis}}"/>
                        </Grid>
                    </Border>

                    <!-- ファイル情報 -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding FileName}"
                                   Foreground="{StaticResource BrText}"
                                   FontSize="12" FontWeight="Bold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FullPath}"
                                   Foreground="{StaticResource BrMuted}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="サイズ: " Foreground="{StaticResource BrMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding SizeStr}" Foreground="{StaticResource BrText}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="更新日時: " Foreground="{StaticResource BrMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding LastWriteStr}" Foreground="{StaticResource BrText}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════
             BOTTOM STATUS BAR
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#0E0E1A"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource BrMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Foreground="#44DCDCF0"
                           FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="差分件数: "/>
                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                    <Run Text=" 件表示中"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
